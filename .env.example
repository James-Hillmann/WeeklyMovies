# --- Weekly Movies environment variables -------------------------------------
# Copy this file to .env.local and fill in the values.
# (On Vercel, set these in Project Settings → Environment Variables instead.)

# Required: Neon Postgres connection string.
# Get one free at https://neon.tech, or provision Neon from the Vercel
# Marketplace and run `vercel env pull .env.local`.
DATABASE_URL=

# Optional but recommended: free TMDB API key for posters + metadata.
# Create one at https://www.themoviedb.org/settings/api (v3 "API Key").
# Leave blank to fall back to plain typed titles.
TMDB_API_KEY=

# Optional: comma-separated display names allowed to spin the wheel.
# Case-insensitive. Example: HOST_NAMES=james,alex
# If left blank, ANYONE can spin (handy while testing).
HOST_NAMES=
