# --- Weekly Movies environment variables -------------------------------------
# Copy this file to .env.local and fill in the values.
# (On Vercel, set these in Project Settings → Environment Variables instead.)

# Required: Neon Postgres connection string.
# Get one free at https://neon.tech, or provision Neon from the Vercel
# Marketplace and run `vercel env pull .env.local`.
DATABASE_URL=

# Optional but recommended: free TMDB API key for posters + metadata.
# Create one at https://www.themoviedb.org/settings/api (v3 "API Key").
# Leave blank to fall back to plain typed titles.
TMDB_API_KEY=

# Optional: 2-letter country code for "Where to watch" streaming availability
# (data via JustWatch). Defaults to US. E.g. TMDB_WATCH_REGION=GB
TMDB_WATCH_REGION=

# Optional: comma-separated display names allowed to spin the reel.
# Case-insensitive. Example: HOST_NAMES=james,alex
# ("admin" is always a host too, baked in.) If left blank, ANYONE can spin.
HOST_NAMES=

# Optional: Discord webhook that gets a rich embed when a movie is picked or
# reviewed. Create one in your server: Server Settings → Integrations →
# Webhooks → New Webhook → pick a channel → Copy Webhook URL. Blank = no posts.
DISCORD_WEBHOOK_URL=

# Optional: a SEPARATE webhook used only when running against the throwaway test
# database (npm run dev:test). Point it at a test channel so experiments never
# hit your real channel. Blank = the test scene posts nothing.
DISCORD_WEBHOOK_URL_TEST=

# Optional: map website names to Discord user IDs so posts can show each
# person's profile photo + accent color. Comma-separated name:id pairs, e.g.
# DISCORD_USER_MAP=nathan:111111111111111111,maxx:222222222222222222
# To get an ID: Discord → User Settings → Advanced → Developer Mode, then
# right-click a user → Copy User ID. Names are matched case-insensitively.
DISCORD_USER_MAP=

# Optional: a Discord BOT TOKEN, used only to look up profile photos + accent
# colors for the names in DISCORD_USER_MAP. The bot does NOT need to join your
# server. Create one at https://discord.com/developers/applications → your app →
# Bot → Reset Token. Without it, posts still work but show names without photos.
DISCORD_BOT_TOKEN=
